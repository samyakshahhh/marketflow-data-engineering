# ---------------------------------------------------------------------------
# MarketFlow environment variables
#
#   cp .env.example .env     (Windows: copy .env.example .env)
#
# Copy the file - do not rename it - so the template stays in the repository.
# .env is git-ignored. Never commit real credentials.
# ---------------------------------------------------------------------------

# --- Financial Modeling Prep ------------------------------------------------
# Free API key: https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=

# --- Snowflake --------------------------------------------------------------
# SNOWFLAKE_ACCOUNT is the account identifier, e.g. abcd-xy12345
# (the part before .snowflakecomputing.com), NOT the full URL.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=FINANCIAL_MARKET_DB
SNOWFLAKE_SCHEMA=BRONZE

# --- Airflow ----------------------------------------------------------------
# Airflow reads this file, so the Snowflake connection is built from the
# variables above - no manual connection setup in the UI is required.
AIRFLOW_UID=50000
AIRFLOW_IMAGE_NAME=marketflow/airflow:3.4.0
# Login for the Airflow UI at http://localhost:8080
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
# Change both of these for anything other than local development.
FERNET_KEY=
AIRFLOW__API_AUTH__JWT_SECRET=marketflow_local_jwt_secret
